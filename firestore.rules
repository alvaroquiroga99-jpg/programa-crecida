rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() && request.auth.token.role != null ? request.auth.token.role : "USUARIO_OPERATIVO";
    }

    function isSuperAdmin() {
      return role() == "SUPER_ADMIN";
    }

    function isAdmin() {
      return role() in ["SUPER_ADMIN", "ADMIN"];
    }

    match /alerts/{alertId} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /recipients/{recipientId} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /acknowledgements/{ackId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    match /auditLog/{eventId} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    match /settings/{docId} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();
    }

    match /externalCache/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // --- Datos públicos de monitoreo (los escribe el vigía por Admin SDK) ---
    match /smn/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /capas/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /sistema/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // --- Confirmaciones de recepción (el destinatario confirma desde el link del mensaje) ---
    match /confirmaciones/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // --- Destinatarios compartidos (demo sin login; luego se restringe por rol) ---
    match /destinatarios/{docId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // --- Alertas emitidas (registro del día; las escribe la app al distribuir) ---
    match /alertas/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

  }
}
